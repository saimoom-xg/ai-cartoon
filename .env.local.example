GEMINI_API_KEY=
# Current Gemini image model. Override when Google changes available image models.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional text-planning model override.
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# Required to persist generated character and scene images.
BLOB_READ_WRITE_TOKEN=
# Optional fallback provider credentials.
OPENROUTER_API_KEY=
# Optional: set a different Gemini model.
# GEMINI_MODEL=gemini-2.5-flash
# Optional OpenRouter model and app attribution.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=AI Cartoon Story Generator
